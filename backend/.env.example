# Copy to .env and edit values. Do not commit .env to Git.

FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_HOURS=3
RUN_SEED_ON_STARTUP=true

SQLALCHEMY_DATABASE_URI=sqlite:///Trek.db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300
TREKKER_OPEN_TREKS_KEY=trekker_open_treks

SMTP_HOST=localhost
SMTP_PORT=1025
SENDER_EMAIL=mail@TMA.com
SENDER_PASSWORD=

CORS_ORIGINS=http://localhost:5173
