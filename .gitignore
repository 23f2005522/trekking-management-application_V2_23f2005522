# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
ENV/
.venv/
backend/venv/

# VS Code settings
.vscode/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs and temp files
*.log
*.tmp

# OS-specific files
.DS_Store
Thumbs.db

# IDE-specific
.idea/
*.sublime-project
*.sublime-workspace

# Database files (local SQLite — do not commit)
*.db
*.sqlite3
backend/instance/

# Redis dump files
dump.rdb
**/dump.rdb

# Celery Beat schedule files (auto-generated locally)
celerybeat-schedule
celerybeat-schedule.*
celerybeat-schedule.bak
celerybeat-schedule.dat
celerybeat-schedule.dir

# Generated CSV export files
backend/exports/*
!backend/exports/.gitkeep

# Session / dev notes & handoff docs (keep README.md for repo)
*.md
!README.md
!frontend/README.md

